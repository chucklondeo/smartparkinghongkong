# Hostinger Apache config for Next.js static export
Options -MultiViews

RewriteEngine On

# Serve pre-compressed .gz assets if available
RewriteCond %{HTTP:Accept-Encoding} gzip
RewriteCond %{REQUEST_FILENAME}.gz -f
RewriteRule ^(.*)$ $1.gz [L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# non-www → www canonical redirect
RewriteCond %{HTTP_HOST} ^londeoaccess\.com\.hk$ [NC]
RewriteRule ^ https://www.londeoaccess.com.hk%{REQUEST_URI} [L,R=301]

# Serve static files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Next.js static export (output: "export", default trailingSlash) writes one
# <route>.html file per page (e.g. products/ai-lpr-camera.html), but every
# <Link>/<a href> in the app points at the extensionless route. MultiViews is
# off above, so map the extensionless URL to its generated .html file here.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# This is now a real multi-page static export (one .html file per route) —
# unmatched paths get a genuine 404 instead of the old SPA-style fallback
# that served index.html (with a 200 status) for every unknown URL.
ErrorDocument 404 /404.html

# Cache static assets aggressively
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                  "access plus 0 seconds"
  ExpiresByType application/javascript     "access plus 1 year"
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType image/png                  "access plus 1 year"
  ExpiresByType image/webp                 "access plus 1 year"
  ExpiresByType font/woff2                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index|404)\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css|png|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
