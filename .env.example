# Supabase project used for the contact form (calls the send-contact-email Edge Function).
# Safe to expose in the browser — these are the public project URL and publishable key, not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Google Analytics 4 measurement ID. Leave blank until a real GA4
# property exists — no analytics script loads or fires without this set.
NEXT_PUBLIC_GA_ID=

# --- Never put the following in this file or in .env.local ---
# The Edge Function's own secrets (RESEND_API_KEY, CONTACT_TO_EMAIL,
# CONTACT_FROM_EMAIL, Supabase service-role key) are configured via
# `supabase secrets set` and are never part of the Next.js bundle.
# See supabase/functions/README.md.
